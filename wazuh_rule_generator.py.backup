        'network': 'network',
        'persistence': 'persistence',
        'exfiltration': 'exfiltration',
        'defacement': 'defacement',
    }
    
    # Rule template with proper Wazuh XML structure
    RULE_TEMPLATE = '''# Wazuh Rule: {title}
# Rule ID: {rule_id}
# Level: {level}
# Generation Date: {generation_date}

<group>{category}</group>
<rule id="{rule_id}" level="{level}">
    {fields}
    {description}
</rule>
'''


class WazuhRuleGenerator:
    """Generate Wazuh detection rules based on various configuration options."""
    
    # Standard Wazuh field definitions
    WAZUH_FIELDS = {
        'hostname': 'Hostname where the event is generated',
        'username': 'Username from the log entry',
        'remote_addr': 'Remote address that generated the event',
        'path': 'File or directory path affected',
        'user': 'Windows user affected by the event',
        'user_label': 'User label',
        'object_label': 'Object label',
        'target_object': 'Target object',
        'target_ref': 'Target reference',
        'source_user': 'Source user',
        'target_user': 'Target user',
        'category': 'Event category',
        'event_type': 'Event type',
        'output_type': 'Output type',
        'process_id': 'Process ID',
        'user_sid': 'User SID',
        'target_sid': 'Target SID',
        'file_name': 'File name',
    }
    
    # Category to Wazuh field definitions mapping
    FIELD_DEFINITIONS = {
        'syslog': ['hostname', 'username', 'remote_addr', 'path', 'user', 'category'],
        'audit': ['user', 'user_sid', 'target_sid', 'path', 'category'],
        'file_integrity': ['path', 'user', 'user_sid', 'target_sid', 'category'],
        'command/windows': ['hostname', 'user', 'remote_addr', 'path', 'process_id'],
        'command/bash': ['hostname', 'user', 'remote_addr', 'path', 'process_id'],
        'registry': ['path', 'user', 'user_sid', 'target_sid', 'category'],
    }
    
    # Rule ID offset (start at 10001 for syslog rules)
    RULE_ID_OFFSET = 10001
    
    # Category prefixes for rule categories
    CATEGORY_PREFIXES = {
        'syslog': 'syslog',
        'audit': 'audit',
        'bash': 'command/bash',
        'perl': 'perl',
        'powershell': 'command/powershell',
        'command_line': 'command/windows',
        'scheduled_scan': 'scheduled_scan',
        'file_integrity': 'file_integrity',
        'registry': 'registry',
        'api': 'command/windows',
        'malware': 'malware',
    }
    
    # Default log level (0-3)
    DEFAULT_LEVEL = '3'
    
    def __init__(self, config_file: Optional[str] = None):
        """Initialize the rule generator."""
        self.rule_id_offset = self.RULE_ID_OFFSET
        self.categories = list(self.CATEGORY_PREFIXES.keys())
        self.config_file = config_file
        self.logger = self._setup_logging()
        self.stats = {
            'rules_generated': 0,
            'bytes_processed': 0,
            'errors': 0,
        }
        self.batch_mode = False
        self.batch_rules: List[Dict] = []
        self._load_config(config_file)
    
    def _setup_logging(self) -> logging.Logger:
        """Configure logging for the generator."""
        logger = logging.getLogger('WazuhRuleGenerator')
        logger.setLevel(logging.INFO)
        handler = logging.StreamHandler()
        formatter = logging.Formatter(
            '%(asctime)s - %(name)s - %(levelname)s - %(message)s'
        )
        handler.setFormatter(formatter)
        logger.addHandler(handler)
        return logger
    
    def _load_config(self, config_file: str) -> None:
        """Load configuration from a YAML or JSON file."""
        try:
            config_path = Path(config_file)
            if config_path.exists():
                self.logger.info(f"Loading configuration from {config_file}")
                # Simple config loading
                import json
                if config_path.suffix.lower() == '.json':
                    with open(config_path) as f:
                        config = json.load(f)
                        if 'rule_id_start' in config:
                            self.rule_id_offset = config['rule_id_start']
                elif config_path.suffix.lower() == '.yaml':
                    # Simple YAML parsing
                    with open(config_path) as f:
                        for line in f:
                            line = line.strip()
                            if line.startswith('rule_id_start='):
                                self.rule_id_offset = int(line.split('=')[1])
                            elif line.startswith('default_level='):
                                self.default_level = line.split('=')[1]
                            elif line.startswith('template_file=') or line.startswith('output_dir='):
                                pass
        except Exception as e:
            self.logger.error(f"Error loading config: {e}")
    
    def add_batch_rule(self, rule_config: Dict) -> None:
        """Add a rule to the batch queue."""
        if self.batch_mode:
            self.batch_rules.append(rule_config)
            self.logger.debug(f"Batched rule configured: {rule_config.get('title', 'Untitled')}")
        else:
            self.logger.warning("Batch mode not enabled. Rule will be generated immediately.")
            self._process_rule_config(rule_config)
    
    def _process_rule_config(self, rule_config: Dict, immediate: bool = True) -> str:
        """Process a rule configuration and generate the rule."""
        rule = self.generate_rule(**rule_config)
        if immediate or not self.batch_rules:
            self.stats['rules_generated'] += 1
            return rule
        return rule



    def set_rule_id(self, rule_id):
        """Set the starting rule ID."""
        self.rule_id = rule_id
    
    def clear_rules(self):
        """Clear the rule ID counter."""
        self.rule_id = 1

    def save_rules(self, filename: str, rules: Optional[List[str]] = None, overwrite: bool = True) -> Path:
        """
        Save one or more rules to a file.
        
        Args:
            filename: Output filename
            rules: List of rule strings to save
            overwrite: Whether to overwrite existing file (default True)
        
        Returns:
            Path to saved file
        """
        output_path = Path(filename)
        
        if rules is None:
            rules = []
        
        if not rules:
            self.logger.warning("No rules to save")
            return output_path
        
        self.logger.info(f"Saving {len(rules)} rules to {filename}")
        
        content = "<ruleset version=\"5\">\n"
        
        for i, rule in enumerate(rules, 1):
            # Add separator line every 100 rules
            if i > 1 and i % 100 == 0:
                content += "<separator/>\n"
            
            content += rule + "\n"
        
        # Add closing tags and integrity settings
        content += "</ruleset>\n"
        content += f"\n<integrity>enable</integrity>\n"
        content += f"<rules_list>{output_path}</rules_list>\n"
        content += "<required_list></required_list>\n"
        
        # Ensure parent directory exists
        output_path.parent.mkdir(parents=True, exist_ok=True)
        
        # Only write if file doesn't exist or overwrite is True
        if output_path.exists() and not overwrite:
            self.logger.warning(f"File {filename} exists, not overwriting")
        else:
            output_path.write_text(content)
        
        self.stats['bytes_processed'] += len(content)
        self.logger.info(f"Saved {len(rules)} rules ({len(content)} bytes) to {output_path}")
        
        return output_path

    def generate_batch(self, batch_rules: List[Dict]) -> List[str]:
        """
        Generate multiple rules from batch configuration.
        
        Args:
            batch_rules: List of rule configurations
        
        Returns:
            List of generated rule strings
        """
        self.batch_mode = True
        rules = []
        
        for i, rule_config in enumerate(batch_rules, 1):
            try:
                self.logger.debug(f"Processing batch rule {i}/{len(batch_rules)}: {rule_config.get('title', 'Untitled')}")
                rule = self._process_rule_config(rule_config, immediate=False)
                if rule:
                    rules.append(rule)
                    self.stats['rules_generated'] += 1
            except Exception as e:
                self.logger.error(f"Error generating rule {i}: {e}")
                self.stats['errors'] += 1
        
        # Save if any rules were generated
        if rules:
            output_dir = Path(self.config_file).parent if self.config_file else Path('./')
            self.save_rules(f"batch_rules_{datetime.now().strftime('%Y%m%d')}.xml", rules)
        
        return rules

    def validate_rule(self, rule: str) -> bool:
        """
        Validate a generated rule for proper Wazuh XML syntax.
        
        Args:
            rule: Rule string to validate
        
        Returns:
            True if valid, False otherwise
        """
        try:
            # Basic XML validation
            from xml.etree.ElementTree import fromstring
            fromstring(rule)
            # Check required elements
            if '<rule' not in rule or '</rule>' not in rule:
                return False
            return True
        except Exception:
            return False

    def generate_with_validation(self, **kwargs) -> Optional[str]:
        """
        Generate and validate a rule in one step.
        
        Args:
            **kwargs: Same as generate_rule
        
        Returns:
            Generated rule if valid, None if invalid
        """
        rule = self.generate_rule(**kwargs)
        if self.validate_rule(rule):
            self.stats['rules_generated'] += 1
            return rule
        else:
            self.logger.error("Generated rule validation failed")
            return None


