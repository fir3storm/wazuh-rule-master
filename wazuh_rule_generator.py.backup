    }
    
    # Enhanced category mappings with Wazuh CIM support
    CATEGORY_PREFIXES = {
        'syslog': 'syslog',
        'audit': 'audit',
        'bash': 'command/bash',
        'perl': 'perl',
        'powershell': 'command/powershell',
        'command_line': 'command/windows',
        'scheduled_scan': 'scheduled_scan',
        'file_integrity': 'file_integrity',
        'registry': 'registry',
        'api': 'command/windows',
