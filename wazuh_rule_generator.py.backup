def main():
    """Main application entry point."""
    generator = WazuhRuleGenerator()
    output_file = "wazuh_rules.xml"
    
    while True:
        display_menu(generator)
        try:
            choice = input("\nEnter your choice (0-6): ").strip()
        except KeyboardInterrupt:
            print("\n\nExiting gracefully...")
            break
        
        if choice == '0':
            print("Goodbye!")
            break
        
        try:
            choice_int = int(choice)
        except ValueError:
            print("Invalid input. Please enter a number between 0 and 6.")
            continue
        
        output_file = input("Enter output filename (default: wazuh_rules.xml): ").strip() or output_file
        
        if choice_int == 1:  # By Category
            print("\nSelect a category (enter 0 to skip all):")
            categories = [
                (1, "1.1", "Syslog/Authentication Events"),
                (1, "1.2", "File Integrity Monitoring"),
                (1, "1.3", "Privilege Escalation Attempts"),
                (1, "1.4", "Unauthorized Access"),
                (1, "1.5", "Malware Detection"),
                (1, "1.6", "Scheduled Scan Events"),
                (1, "1.7", "Registry Changes"),
                (1, "1.8", "Custom Pattern"),
            ]
            selected_categories = []
            for idx, (num, name, desc) in enumerate(categories, 1):
                try:
                    sub = input(f"  {desc} (enter {num} to add, 'q' to quit): ").strip()
                    if sub.lower() == 'q':
                        break
                    if sub == str(num):
                        selected_categories.append((idx, num, desc))
                        print(f"    ✓ {desc} selected")
                except KeyboardInterrupt:
                    break
            
            if selected_categories:
                for cat_id, cat_num, cat_desc in selected_categories:
                    if cat_num.startswith("1.7"):
                        cat = "registry"
                    elif cat_num.startswith("1.5"):
                        cat = "malware"
                    elif cat_num.startswith("1.6"):
                        cat = "scheduled_scan"
                    elif cat_num == "1.8":
                        cat = "custom"
                    else:
                        cat = "syslog"
                    
                    level = input(f"\n  Level for {cat_desc} (0-3, default 3): ").strip() or "3"
                    custom_field = input(f"  Custom field (optional): ").strip()
                    description = input(f"  Description (optional): ").strip()
                    
                    rule = generator.generate_rule(
                        title=f"Custom rule for {cat_desc}",
                        category=cat,
                        level=level or "3",
                        description=description or f"Rule for {cat_desc}",
                        fields=custom_field or ""
                    )
                    generator.save_rules(output_file, rules=[rule])
            
            elif not selected_categories:
                print("\n  No categories selected. No rules generated.")
        
        elif choice_int == 2:  # File Operations
            print("\n  Select file operation (enter 0 to skip all):")
            file_ops = [
                (1, "2.1", "File Deletions"),
                (2, "2.2", "File Modifications"),
                (3, "2.3", "New File Creation"),
                (4, "2.4", "New File Deletion"),
                (5, "2.5", "File Downloaded"),
                (6, "2.6", "File Integrity Check Failures"),
            ]
            selected_ops = []
            for idx, (num, name, desc) in enumerate(file_ops, 1):
                try:
                    sub = input(f"  {desc} (enter {num} to add, 'q' to quit): ").strip()
                    if sub.lower() == 'q':
                        break
                    if sub == str(num):
                        selected_ops.append((idx, num, desc))
                        print(f"    ✓ {desc} selected")
                except KeyboardInterrupt:
                    break
            
            if selected_ops:
                for op_id, op_num, op_desc in selected_ops:
                    path = input(f"  Path for {op_desc} (optional): ").strip()
                    user = input(f"  User (optional): ").strip()
                    level = input(f"  Level (default 3): ").strip() or "3"
                    
                    fields = ""
                    if path:
                        fields += f"path={path}\n\n"
                    if user:
                        fields += f"user={user}\n"
                    
                    rule = generator.generate_rule(
                        title=f"File operation: {op_desc}",
                        category="file_integrity",
                        level=level or "3",
                        description=f"Rule for {op_desc}",
                        fields=fields
                    )
                    generator.save_rules(output_file, rules=[rule])
        
        elif choice_int == 3:  # Windows Events
            print("\n  Select Windows event (enter 0 to skip all):")
            windows_events = [
                (1, "3.1", "PowerShell Executed"),
                (2, "3.2", "Command Executed"),
                (3, "3.3", "User Token Manipulated"),
                (4, "3.4", "Registry Value Changed"),
                (5, "3.5", "Logon/Logoff"),
                (6, "3.6", "Network Connection"),
            ]
            selected_events = []
            for idx, (num, name, desc) in enumerate(windows_events, 1):
                try:
                    sub = input(f"  {desc} (enter {num} to add, 'q' to quit): ").strip()
                    if sub.lower() == 'q':
                        break
                    if sub == str(num):
                        selected_events.append((idx, num, desc))
                        print(f"    ✓ {desc} selected")
                except KeyboardInterrupt:
                    break
            
            if selected_events:
                for ev_id, ev_num, ev_desc in selected_events:
                    user = input(f"  User for {ev_desc} (optional): ").strip()
                    target = input(f"  Target (optional): ").strip()
                    level = input(f"  Level (default 3): ").strip() or "3"
                    
                    fields = ""
                    if user:
                        fields += f"user={user}\n"
                    if target:
                        fields += f"target_ref={target}\n"
                    
                    rule = generator.generate_rule(
                        title=f"Windows event: {ev_desc}",
                        category="command/powershell",
                        level=level or "3",
                        description=f"Rule for {ev_desc}",
                        fields=fields
                    )
                    generator.save_rules(output_file, rules=[rule])
        
        elif choice_int == 4:  # Network Events
            print("\n  Select network event (enter 0 to skip all):")
            network_events = [
                (1, "4.1", "Connection Events"),
                (2, "4.2", "Connection Attempts"),
                (3, "4.3", "Domain Name Requests"),
                (4, "4.4", "LDAP Access"),
            ]
            selected_net = []
            for idx, (num, name, desc) in enumerate(network_events, 1):
                try:
                    sub = input(f"  {desc} (enter {num} to add, 'q' to quit): ").strip()
                    if sub.lower() == 'q':
                        break
                    if sub == str(num):
                        selected_net.append((idx, num, desc))
                        print(f"    ✓ {desc} selected")
                except KeyboardInterrupt:
                    break
            
            if selected_net:
                for net_id, net_num, net_desc in selected_net:
                    remote = input(f"  Remote address for {net_desc} (optional): ").strip()
                    level = input(f"  Level (default 3): ").strip() or "3"
                    
                    fields = ""
                    if remote:
                        fields += f"remote_addr={remote}\n"
                    
                    rule = generator.generate_rule(
                        title=f"Network event: {net_desc}",
                        category="syslog",
                        level=level or "3",
                        description=f"Rule for {net_desc}",
                        fields=fields
                    )
                    generator.save_rules(output_file, rules=[rule])
        
        elif choice_int == 5:  # API Events
            print("\n  Select API event (enter 0 to skip all):")
            api_events = [
                (1, "5.1", "API Called"),
                (2, "5.2", "API Key Used"),
                (3, "5.3", "API User Login"),
            ]
            selected_api = []
            for idx, (num, name, desc) in enumerate(api_events, 1):
                try:
                    sub = input(f"  {desc} (enter {num} to add, 'q' to quit): ").strip()
                    if sub.lower() == 'q':
                        break
                    if sub == str(num):
                        selected_api.append((idx, num, desc))
                        print(f"    ✓ {desc} selected")
                except KeyboardInterrupt:
                    break
            
            if selected_api:
                for api_id, api_num, api_desc in selected_api:
                    action = input(f"  API action for {api_desc} (optional): ").strip()
                    level = input(f"  Level (default 3): ").strip() or "3"
                    
                    fields = f"api_action={action}\n" if action else ""
                    
                    rule = generator.generate_rule(
                        title=f"API event: {api_desc}",
                        category="command/windows",
                        level=level or "3",
                        description=f"Rule for {api_desc}",
                        fields=fields
                    )
                    generator.save_rules(output_file, rules=[rule])
        
        elif choice_int == 6:  # Quick Generation
            quick_rules = {
                "syslog_auth_failure": "syslog:authentication failure; hostname=any; username=\"*\"; level=3",
                "file_integrity_modification": "file_integrity; path=\"*\"; user=\"*\"; level=3",
                "privilege_escalation": "command/windows;pam_unix;level=2",
                "powershell_exec": "command/powershell; powershell; level=2",
                "brute_force": "syslog;authentication failure;level=1",
                "root_squid": "syslog;root squid;level=1",
            }
            
            print("\nQuick Rules (select numbers to add):")
            for name, pattern in quick_rules.items():
                selected = input(f"  {name} {pattern} (enter {name} to add, 'q' to quit): ").strip()
                if selected.lower() in [name, '1']:
                    rule = generator.generate_rule(
                        title=pattern.split(";")[0].strip(),
                        category="syslog",
                        level="3",
                        description=pattern
                    )
                    generator.save_rules(output_file, rules=[rule])
        
        print(f"\n✓ Rules saved to: {output_file}")
        
        try_again = input(
            "\nGenerate more rules? (y/n, default n): "
        ).strip().lower()
        if try_again != 'y':
            break
        
        # Reset output file for next iteration
        if try_again == 'y':
            print(f"\nClearing and using new file: {output_file}")
        
    print(f"\n  Final rules file: {output_file}")
    print("=" * 60)


def add_argument_parser() -> argparse.ArgumentParser:
    """Create and return the argument parser."""
    parser = argparse.ArgumentParser(
        description='Wazuh Rule Generator - Generate and validate Wazuh security rules',
        epilog='Use "%%(prog) -h" for more information.'
    )
    
    parser.add_argument(
        '--output',
        '-o',
        default='wazuh_rules.xml',
        help='Output file path (default: wazuh_rules.xml)'
    )
    
    parser.add_argument(
        '--category',
        '-c',
        choices=list(WazuhRuleGenerator.CATEGORY_PREFIXES.keys()),
        help='Rule category (syslog, audit, file_integrity, etc.)'
    )
    
    parser.add_argument(
        '--title',
        '-t',
        required=True,
        help='Rule title/description'
    )
    
    parser.add_argument(
        '--rule-id',
        '-id',
        help='Rule ID (use "auto" for automatic ID based on order)'
    )
    
    parser.add_argument(
        '--level',
        '-l',
        type=int,
        choices=[0, 1, 2, 3],
        help='Rule severity level (0-3, default: 3)'
    )
    
    parser.add_argument(
        '--username',
        '-u',
        help='Username to include in the rule'
    )
    
    parser.add_argument(
        '--remote-addr',
        '-ra',
        help='Remote IP address to detect'
    )
    
    parser.add_argument(
        '--path',
        '-p',
        help='File or directory path'
    )
    
    parser.add_argument(
        '--user',
        help='Windows user'
    )
    
    parser.add_argument(
        '--batch',
        '-b',
        action='store_true',
        help='Enable batch mode for multiple rule generation'
    )
    
    parser.add_argument(
        '--batch-config-file',
        help='Path to JSON/YAML batch configuration file'
    )
    
    parser.add_argument(
        '--config',
        '-conf',
        help='Path to configuration file'
    )
    
    parser.add_argument(
        '--validate',
        '-v',
        action='store_true',
        help='Validate generated rule before exiting'
    )
    
    parser.add_argument(
        '--sample',
        '-s',
        action='store_true',
        help='Generate sample rules for testing'
    )
    
    return parser


def parse_args_from_input(user_input: str) -> Dict:
    """Parse user input into rule configuration.
    
    Args:
        user_input: User prompt response (e.g., "10001:syslog:Authentication Failure:1")
        
    Returns:
        Dictionary of rule parameters or empty dict if unrecognized
    """
    if not user_input:
        return {}
    
    try:
        parts = user_input.strip().split(':')
        if len(parts) >= 3:
            return {
                'rule_id': parts[0] or 'auto',
                'category': parts[1],
                'title': parts[2],
                'level': '1' if 'authentication' in parts[2].lower() or 'squid' in parts[2].lower() else '3',
            }
    except Exception:
        pass
    return {}


def main():
    """Main application entry point."""
    generator = WazuhRuleGenerator()
    output_file = "wazuh_rules.xml"
    
    # Check for sample generation
    if generator.batch_mode:
        # Use argparse
        parser = add_argument_parser()
        args = parser.parse_args()
        
        if args.batch:
            generator.batch_mode = True
            
            # Generate rules based on command line arguments
            if args.category and args.title:
                generator.generate_rule(
                    title=args.title,
                    category=args.category,
                    rule_id=args.rule_id or 'auto',
                    level=args.level,
                    username=args.username or None,
                    remote_addr=args.remote_addr or None,
                    path=args.path or None,
                    user=args.user or None,
                )
                return
    
    while True:
        display_menu(generator)
        try:
            choice = input("\nEnter your choice (0-6): ").strip()
        except KeyboardInterrupt:
            print("\n\nExiting gracefully...")
            break
        
        if choice == '0':
            print("Goodbye!")
            # Print final statistics
            print(f"\n=== Session Statistics ===")
            print(f"Rules generated: {generator.stats['rules_generated']}")
            print(f"Bytes processed: {generator.stats['bytes_processed']}")
            print(f"Errors: {generator.stats['errors']}")
            break
        
        try:
            choice_int = int(choice)
        except ValueError:
            print("Invalid input. Please enter a number between 0 and 6.")
            continue
        
        output_file = input("Enter output filename (default: wazuh_rules.xml): ").strip() or output_file
        
        try_again = ''
        
        if choice_int == 1:
            print("\nSelect a category (enter 0 to skip all):")
            categories = [
                (1, "1.1", "Syslog/Authentication Events"),
                (1, "1.2", "File Integrity Monitoring"),
                (1, "1.3", "Privilege Escalation Attempts"),
                (1, "1.4", "Unauthorized Access"),
                (1, "1.5", "Malware Detection"),
                (1, "1.6", "Scheduled Scan Events"),
                (1, "1.7", "Registry Changes"),
                (1, "1.8", "Custom Pattern"),
            ]
            selected_categories = []
            for idx, (num, name, desc) in enumerate(categories, 1):
                try:
                    sub = input(f"  {desc} (enter {num} to add, 'q' to quit): ").strip()
                    if sub.lower() == 'q':
                        break
                    if sub == str(num):
                        selected_categories.append((idx, num, desc))
                        print(f"    ✓ {desc} selected")
                except KeyboardInterrupt:
                    break
            
            if selected_categories:
                for cat_id, cat_num, cat_desc in selected_categories:
                    if cat_num.startswith("1.7"):
                        cat = "registry"
                    elif cat_num.startswith("1.5"):
                        cat = "malware"
                    elif cat_num.startswith("1.6"):
                        cat = "scheduled_scan"
                    elif cat_num == "1.8":
                        cat = "custom"
                    else:
                        cat = "syslog"
                    
                    level = input(f"\n  Level for {cat_desc} (0-3, default 3): ").strip() or "3"
                    custom_field = input(f"  Custom field (optional): ").strip()
                    description = input(f"  Description (optional): ").strip()
                    
                    rule = generator.generate_rule(
                        title=f"Custom rule for {cat_desc}",
                        category=cat,
                        level=level or "3",
                        description=description or f"Rule for {cat_desc}",
                        fields=custom_field or ""
                    )
                    generator.save_rules(output_file, rules=[rule])
            
            elif not selected_categories:
                print("\n  No categories selected. No rules generated.")
        
        elif choice_int == 2:
            print("\n  Select file operation (enter 0 to skip all):")
            file_ops = [
                (1, "2.1", "File Deletions"),
                (2, "2.2", "File Modifications"),
                (3, "2.3", "New File Creation"),
                (4, "2.4", "New File Deletion"),
                (5, "2.5", "File Downloaded"),
                (6, "2.6", "File Integrity Check Failures"),
            ]
            selected_ops = []
            for idx, (num, name, desc) in enumerate(file_ops, 1):
                try:
                    sub = input(f"  {desc} (enter {num} to add, 'q' to quit): ").strip()
                    if sub.lower() == 'q':
                        break
                    if sub == str(num):
                        selected_ops.append((idx, num, desc))
                        print(f"    ✓ {desc} selected")
                except KeyboardInterrupt:
                    break
            
            if selected_ops:
                for op_id, op_num, op_desc in selected_ops:
                    path = input(f"  Path for {op_desc} (optional): ").strip()
                    user = input(f"  User (optional): ").strip()
                    level = input(f"  Level (default 3): ").strip() or "3"
                    
                    fields = ""
                    if path:
                        fields += f"path={path}\n\n"
                    if user:
                        fields += f"user={user}\n"
                    
                    rule = generator.generate_rule(
                        title=f"File operation: {op_desc}",
                        category="file_integrity",
                        level=level or "3",
                        description=f"Rule for {op_desc}",
                        fields=fields
                    )
                    generator.save_rules(output_file, rules=[rule])
        
        elif choice_int == 3:
            print("\n  Select Windows event (enter 0 to skip all):")
            windows_events = [
                (1, "3.1", "PowerShell Executed"),
                (2, "3.2", "Command Executed"),
                (3, "3.3", "User Token Manipulated"),
                (4, "3.4", "Registry Value Changed"),
                (5, "3.5", "Logon/Logoff"),
                (6, "3.6", "Network Connection"),
            ]
            selected_events = []
            for idx, (num, name, desc) in enumerate(windows_events, 1):
                try:
                    sub = input(f"  {desc} (enter {num} to add, 'q' to quit): ").strip()
                    if sub.lower() == 'q':
                        break
                    if sub == str(num):
                        selected_events.append((idx, num, desc))
                        print(f"    ✓ {desc} selected")
                except KeyboardInterrupt:
                    break
            
            if selected_events:
                for ev_id, ev_num, ev_desc in selected_events:
                    user = input(f"  User for {ev_desc} (optional): ").strip()
                    target = input(f"  Target (optional): ").strip()
                    level = input(f"  Level (default 3): ").strip() or "3"
                    
                    fields = ""
                    if user:
                        fields += f"user={user}\n"
                    if target:
                        fields += f"target_ref={target}\n"
                    
                    rule = generator.generate_rule(
                        title=f"Windows event: {ev_desc}",
                        category="command/powershell",
                        level=level or "3",
                        description=f"Rule for {ev_desc}",
                        fields=fields
                    )
                    generator.save_rules(output_file, rules=[rule])
        
        elif choice_int == 4:
            print("\n  Select network event (enter 0 to skip all):")
            network_events = [
                (1, "4.1", "Connection Events"),
                (2, "4.2", "Connection Attempts"),
                (3, "4.3", "Domain Name Requests"),
                (4, "4.4", "LDAP Access"),
            ]
            selected_net = []
            for idx, (num, name, desc) in enumerate(network_events, 1):
                try:
                    sub = input(f"  {desc} (enter {num} to add, 'q' to quit): ").strip()
                    if sub.lower() == 'q':
                        break
                    if sub == str(num):
                        selected_net.append((idx, num, desc))
                        print(f"    ✓ {desc} selected")
                except KeyboardInterrupt:
                    break
            
            if selected_net:
                for net_id, net_num, net_desc in selected_net:
                    remote = input(f"  Remote address for {net_desc} (optional): ").strip()
                    level = input(f"  Level (default 3): ").strip() or "3"
                    
                    fields = ""
                    if remote:
                        fields += f"remote_addr={remote}\n"
                    
                    rule = generator.generate_rule(
                        title=f"Network event: {net_desc}",
                        category="syslog",
                        level=level or "3",
                        description=f"Rule for {net_desc}",
                        fields=fields
                    )
                    generator.save_rules(output_file, rules=[rule])
        
        elif choice_int == 5:
            print("\n  Select API event (enter 0 to skip all):")
            api_events = [
                (1, "5.1", "API Called"),
                (2, "5.2", "API Key Used"),
                (3, "5.3", "API User Login"),
            ]
            selected_api = []
            for idx, (num, name, desc) in enumerate(api_events, 1):
                try:
                    sub = input(f"  {desc} (enter {num} to add, 'q' to quit): ").strip()
                    if sub.lower() == 'q':
                        break
                    if sub == str(num):
                        selected_api.append((idx, num, desc))
                        print(f"    ✓ {desc} selected")
                except KeyboardInterrupt:
                    break
            
            if selected_api:
                for api_id, api_num, api_desc in selected_api:
                    action = input(f"  API action for {api_desc} (optional): ").strip()
                    level = input(f"  Level (default 3): ").strip() or "3"
                    
                    fields = f"api_action={action}\n" if action else ""
                    
                    rule = generator.generate_rule(
                        title=f"API event: {api_desc}",
                        category="command/windows",
                        level=level or "3",
                        description=f"Rule for {api_desc}",
                        fields=fields
                    )
                    generator.save_rules(output_file, rules=[rule])
        
        elif choice_int == 6:
            quick_rules = {
                "syslog_auth_failure": "syslog:authentication failure; hostname=any; username=\"*\"; level=1",
                "file_integrity_modification": "file_integrity; path=\"*\"; user=\"*\"; level=1",
                "privilege_escalation": "command/windows;pam_unix;level=2",
                "powershell_exec": "command/powershell; powershell; level=2",
                "brute_force": "syslog;authentication failure;level=1",
                "root_squid": "syslog;root squid;level=1",
            }
            
            print("\nQuick Rules (select numbers to add):")
            for name, pattern in quick_rules.items():
                selected = input(f"  {name} {pattern} (enter {name} to add, 'q' to quit): ").strip()
                if selected.lower() in [name, '1']:
                    rule = generator.generate_rule(
                        title=pattern.split(";")[0].strip(),
                        category="syslog",
                        level="3",
                        description=pattern
                    )
                    generator.save_rules(output_file, rules=[rule])
        
        print(f"\n✓ Rules saved to: {output_file}")
        
        if try_again != 'y':
            break
        
        print(f"\n  Final rules file: {output_file}")
        print("=" * 60)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n\nGoodbye!")
    except Exception as e:
        print(f"\nError occurred: {e}")
